# Copy this file to .env and fill in real values.

# Any random long string — used to sign sessions & password-reset tokens.
SECRET_KEY=change-this-to-something-random

# MongoDB connection. Local example, or use a MongoDB Atlas URI.
MONGO_URI=mongodb://localhost:27017
MONGO_DBNAME=

# How long a password-reset link stays valid, in seconds.
RESET_TOKEN_MAX_AGE=1800

# Optional: real email sending for "forgot password". If left blank, the
# app runs in dev mode and shows the reset link directly on the page /
# server log instead of emailing it.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
